{
  "model": "A_risk_classification_xgboost",
  "target": "risk_score",
  "numeric_features": [
    "age",
    "chronic_flag",
    "length_of_stay_hours",
    "days_since_registration",
    "visit_month",
    "visit_dayofweek",
    "is_weekend"
  ],
  "categorical_features": [
    "department",
    "visit_type",
    "gender",
    "city",
    "insurance_provider"
  ],
  "leakage_excluded": [
    "billed_amount",
    "approved_amount",
    "claim_status",
    "payment_days",
    "realization_ratio",
    "is_zero_approved",
    "payment_delay_band",
    "high_risk_flag",
    "billing_date"
  ]
}